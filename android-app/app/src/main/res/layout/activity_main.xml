<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1425">

    <!-- 自定义背景（本地图片，仅本机保存） -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/bg_custom_desc" />

    <!-- 遮罩层：保证文字在任意图片上都可读 -->
    <View
        android:id="@+id/bgDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#070b16"
        android:alpha="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

    <!-- 连接设置区 -->
    <LinearLayout
        android:id="@+id/connectLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E61a1f36"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_title"
                android:textColor="#eaf0ff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAppearance"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="@string/btn_background"
                android:textColor="#5b8cff"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_url"
            android:textColorHint="#6b7a99"
            android:textColor="#eaf0ff"
            android:background="#232a44"
            android:padding="10dp"
            android:textSize="14sp"
            android:inputType="textUri" />

        <!-- 局域网自动发现的设备：点选即填入地址 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <Spinner
                android:id="@+id/spDevices"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#232a44"
                android:paddingHorizontal="6dp"
                android:spinnerMode="dropdown" />

            <Button
                android:id="@+id/btnDiscover"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="@string/btn_scan"
                android:textColor="#5b8cff"
                android:textSize="13sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDiscoverHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/discover_scanning_auto"
            android:textColor="#6b7a99"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_token"
            android:textColorHint="#6b7a99"
            android:textColor="#eaf0ff"
            android:background="#232a44"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_connect"
                android:textColor="#ffffff"
                android:backgroundTint="#5b8cff" />

            <Button
                android:id="@+id/btnUpload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_upload"
                android:textColor="#ffffff"
                android:backgroundTint="#31d6b0"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 辅助功能行：扫码 + 已下载 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnScan"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_qrscan"
                android:textColor="#5b8cff"
                android:textSize="13sp"
                android:paddingVertical="4dp" />

            <Button
                android:id="@+id/btnOpenDownloads"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_downloads"
                android:textColor="#5b8cff"
                android:textSize="13sp"
                android:paddingVertical="4dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 信息条 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_disconnected"
        android:textColor="#93a0c4"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progressTint="#31d6b0"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#31d6b0"
            android:textSize="11sp"
            android:gravity="start" />

        <Spinner
            android:id="@+id/spSpace"
            android:layout_width="132dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="#232a44"
            android:paddingHorizontal="6dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <!-- 文件列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#00000000"
        android:clipToPadding="false"
        android:padding="4dp" />

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_files"
        android:textColor="#6b7a99"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
